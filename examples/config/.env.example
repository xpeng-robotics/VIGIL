# Copy to .env, edit, then load explicitly: source .env
# OpenAI-compatible endpoints include vLLM and LiteLLM.
export VIGIL_BACKEND="openai-compatible"
export VIGIL_MODEL_BASE_URL="http://127.0.0.1:8000/v1/chat/completions"
export VIGIL_MODEL_NAME="your-model-name"
export VIGIL_API_KEY=""

# Native providers: set VIGIL_BACKEND to gemini, anthropic, or openai.
# For Gemini/Anthropic/OpenAI, remove VIGIL_MODEL_BASE_URL to use the provider URL.
# export GEMINI_API_KEY=""
# export ANTHROPIC_API_KEY=""
# export OPENAI_API_KEY=""

# Set this when running an installed package outside the release directory.
# export VIGIL_DATA_ROOT="/path/to/vigil-release/data"
# Linux headless rendering, after preparing the GPU driver:
# export VIGIL_THOR_PLATFORM="cloud"
# Endpoints without JSON response-format support:
# export VIGIL_SUPPORTS_JSON_MODE="0"

# Match the selected model's coordinate contract; see docs/reference/API_ALIGNMENT.md.
# export VIGIL_COORD_MODE="normalized_1000"
# export VIGIL_COORD_PROMPT_MODE="explicit"
# export VIGIL_MAX_TOKENS="4096"
# export VIGIL_MAX_TOKENS_FIELD="max_completion_tokens"
# export VIGIL_IMAGE_DETAIL="default"
# Transport retries are fingerprinted and shared by all providers.
# export VIGIL_MODEL_REQUEST_MAX_RETRIES="2"
# export VIGIL_MODEL_REQUEST_RETRY_DELAY_S="1"
